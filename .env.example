# Optional. Leave unset so the hero form posts to this site (/api/newsletter/subscribe
# and /api/demo/request), which forward to the founder dashboard. Only set these if you
# want the browser to call the dashboard directly (local CORS testing).
# NEXT_PUBLIC_NEWSLETTER_SUBSCRIBE_URL=http://localhost:3001/api/newsletter/subscribe
# NEXT_PUBLIC_DEMO_REQUEST_URL=http://localhost:3001/api/demo/request

# Server-side origin for the proxy (Vercel defaults to the founder platform).
# FOUNDER_API_ORIGIN=https://elahfounderplatform.vercel.app
